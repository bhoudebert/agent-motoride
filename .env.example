# Copy to .env and fill in what you use. One comment per setting; commented
# lines show the default. Every run is logged: npm run rides -- runs

# Anthropic API key (https://platform.claude.com/): the terminal app, and scouts in Claude Code or Codex
ANTHROPIC_API_KEY=

# Or a bearer token instead of the key, as the Anthropic SDK accepts (e.g. behind a gateway)
# ANTHROPIC_AUTH_TOKEN=

# Your start and end point: a town, a street or an address, or "lat,lon" (overridden by --from)
RIDE_HOME=

# Optional TomTom key (https://developer.tomtom.com/, free tier): traffic at departure
TOMTOM_API_KEY=

# 1 permits motorways by default (--allow-motorways, /motorways on|off per session)
# RIDE_ALLOW_MOTORWAYS=0

# Target max % of distance in zones of 30 km/h or less (--max-30-pct)
# RIDE_MAX_30_PCT=3

# Target max % of distance in 31-50 km/h zones (--max-50-pct)
# RIDE_MAX_50_PCT=20

# Saved rides and lookup cache, one SQLite file; default data/agentmotoride.db in the project
# RIDE_DB=

# Port of the phone share page (/share, rides share)
# RIDE_SHARE_PORT=8787

# Model of the terminal app's planner; cheaper: claude-sonnet-5-5 (half price), claude-haiku-4-5 (quarter)
# RIDE_MODEL=claude-opus-5-5

# Reasoning effort of the planner: low | medium | high | xhigh | max (ignored by Haiku)
# RIDE_EFFORT=high

# Scouts explore candidate areas in parallel for a new ride; 0 turns them off (they bill ANTHROPIC_API_KEY, also under Claude Code or Codex)
# RIDE_SCOUTS=1

# Model of each scout
# RIDE_SCOUT_MODEL=claude-sonnet-5-5

# Reasoning effort of each scout
# RIDE_SCOUT_EFFORT=low
