# Required: Claude API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=

# Default start/end point of rides (overridden by --from)
RIDE_HOME=

# Optional: enables getTraffic (https://developer.tomtom.com/, free tier)
TOMTOM_API_KEY=

# Road preferences (defaults shown). CLI flags override these.
# RIDE_ALLOW_MOTORWAYS=0
# RIDE_MAX_30_PCT=3
# RIDE_MAX_50_PCT=20

# Saved rides and lookup cache (SQLite). Default: data/agentride.db in the project
# RIDE_DB=

# Optional overrides
# Model and reasoning effort. Cheaper: claude-sonnet-5-5 (half price), claude-haiku-4-5 (quarter).
# Effort: low | medium | high | xhigh | max (ignored by Haiku). Every run is logged: npm run rides -- runs
# RIDE_MODEL=claude-opus-5-5
# RIDE_EFFORT=high

# Scouts: the sub-agents that explore candidate areas in parallel for a new ride.
# RIDE_SCOUT_MODEL=claude-sonnet-5-5
# RIDE_SCOUT_EFFORT=low
# RIDE_SCOUTS=0 disables scouts (e.g. under an MCP client, where they would still bill ANTHROPIC_API_KEY)
