# Required: Claude API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=

# Default start/end point of rides (overridden by --from)
RIDE_HOME=

# Optional: enables getTraffic (https://developer.tomtom.com/, free tier)
TOMTOM_API_KEY=

# Road preferences (defaults shown). CLI flags override these.
# RIDE_ALLOW_MOTORWAYS=0
# RIDE_MAX_30_PCT=3
# RIDE_MAX_50_PCT=20

# Saved rides and lookup cache (SQLite). Default: data/agentride.db in the project
# RIDE_DB=

# Optional overrides
# RIDE_MODEL=claude-opus-5-5
# RIDE_EFFORT=high
