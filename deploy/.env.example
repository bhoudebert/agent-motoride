# Copy to deploy/.env and set the first two values; the rest is optional.
# The domain that points at this machine (a DNS A record); Caddy gets its certificate.
RIDE_DOMAIN=rides.example.org
# What `admin add` prints for riders to connect to.
RIDE_SERVER_URL=https://rides.example.org
# Where the riders' data lives on this machine: an absolute path to a folder owned by uid 1000 (`chown 1000:1000 <folder>`).
# Left unset, a Docker volume is used.
# RIDE_DATA_PATH=/srv/agent-motoride
# Optional: your own Valhalla (docker compose --profile valhalla up -d): VALHALLA_URL=http://valhalla:8002. Unset: the public server.
# VALHALLA_URL=
# VALHALLA_TILE_URLS=  (space-separated .osm.pbf downloads; default France and Belgium)
# VALHALLA_THREADS=4
# VALHALLA_REBUILD=False  (set by deploy/update-map.sh for the rebuild; leave it False)
# Optional: traffic on the MotoRide phone's route (docs/guide/phone-and-gps.md). Your own TomTom key
# (https://developer.tomtom.com/, free tier): you accept TomTom's terms and answer for the quota. Without it the traffic comes from French open data (TRAFFIC_PROVIDER, ADR 0042).
# TOMTOM_API_KEY=
# Optional: speed limit signs from Mapillary street-level photos, for the roadbook files (docs/guide/self-hosting.md,
# ADR 0046). Your own free token (https://www.mapillary.com/developer); you accept Mapillary's terms. Empty: off.
# MAPILLARY_ACCESS_TOKEN=
# The most TomTom requests the server may make a day, so riders cannot use up your quota (default 600).
# TRAFFIC_MAX_PER_DAY=600
# TRAFFIC_PROVIDER=open-data  (the default: open data, no key; or off; or tomtom-flow with your own TomTom plan, see the self-hosting guide)
