# nginx in front of the server (docs/guide/self-hosting.md). TLS is yours (certbot, your usual setup): a token travels
# in a header, so this must be https. Only what the server is meant to show to the internet is passed; the rest is 404.
server {
    listen 443 ssl;
    http2 on;
    server_name rides.example.org;
    # ssl_certificate     /etc/letsencrypt/live/rides.example.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/rides.example.org/privkey.pem;

    # The tools (with a token), the health check, a phone's invitation, the phone's traffic, and the live ride relay with its page.
    location ~ ^/(mcp|health|enrol|traffic|roadbooks|rides|follow\.js)$ { proxy_pass http://127.0.0.1:8788; include /etc/nginx/ride-proxy.conf; }
    location ~ ^/rides/[^/]+$ { proxy_pass http://127.0.0.1:8788; include /etc/nginx/ride-proxy.conf; }
    location ~ ^/roadbook/[0-9]+$ { proxy_pass http://127.0.0.1:8788; include /etc/nginx/ride-proxy.conf; }
    location ~ ^/(follow|share)/                 { proxy_pass http://127.0.0.1:8788; include /etc/nginx/ride-proxy.conf; }
    location /                                   { return 404; }
}
