# Save as /etc/nginx/ride-proxy.conf (included by the server block of nginx.conf.example).
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
# The tools answer as a stream: do not hold it back, and do not cut a session that is quiet for a while.
proxy_buffering off;
proxy_read_timeout 1h;
proxy_send_timeout 1h;
client_max_body_size 2m;
